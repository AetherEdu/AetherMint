# =============================================================================
# AetherMint Frontend Environment Variables
# Copy this file to .env.local and fill in the values.
# All NEXT_PUBLIC_* variables are exposed to the browser.
# =============================================================================

# ---- REQUIRED ----------------------------------------------------------------

# Stellar public key that receives course enrollment payments.
# Must be a valid 56-character Stellar address starting with "G".
# Example: GAAZI4TCR3TY5OJHCTJC2A4QSY6CJWJH5IAJTGKIN2ER7LBNVKOCCWNA
NEXT_PUBLIC_STELLAR_RECEIVER_ADDRESS=

# ---- OPTIONAL ----------------------------------------------------------------

# Base URL of the AetherMint backend API server.
# Used for collaboration rooms and general API calls.
# Default: http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# WebSocket server URL for real-time features.
# Default: ws://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# API URL for the consciousness/general services.
# Default: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# API base URL used by the discovery/course service.
# Default: http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# VAPID public key for Web Push notifications.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Socket.IO server URL for gamification/leaderboard real-time updates.
# Default: http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Public site origin, used for canonical URLs, sitemap, robots.txt, and JSON-LD.
# Default: https://aethermint.edu
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public app origin, used when building shareable verification links.
# Defaults to NEXT_PUBLIC_SITE_URL when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Endpoint that receives client-side error reports from the ErrorBoundary.
# Leave empty to disable client-side error reporting.
NEXT_PUBLIC_ERROR_MONITORING_ENDPOINT=

# ---- STELLAR / IPFS (reserved) ----------------------------------------------
# The app currently proxies Stellar RPC and IPFS access through the backend API,
# so these are not required. Set them only if you enable direct browser access
# in a future configuration.

# Soroban RPC endpoint for direct browser-to-network reads.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# IPFS gateway used to resolve content CIDs in the browser.
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# ---- CDN ---------------------------------------------------------------------
# Base URL of the CDN that serves built Next.js static assets (the /_next/static path).
# Leave empty for local development. In production set it to your CDN origin,
# for example https://cdn.aethermint.example. Next.js uses this value as assetPrefix.
ASSET_PREFIX=
